{
  "schema_version": "4.0",
  "description": "EMS v3 — 三层架构：raw 全量日志 → 日去重文件 → 合并压缩 consolidated",
  "entry_types": {
    "knowledge": {
      "description": "Factual knowledge learned — code, commands, concepts, workflows",
      "fields": ["timestamp", "topic", "detail", "source", "tags", "confidence"]
    },
    "decision": {
      "description": "A decision made, with rationale and alternatives considered",
      "fields": ["timestamp", "what", "why", "alternatives", "impact"]
    },
    "preference": {
      "description": "User preference or behavior pattern discovered",
      "fields": ["timestamp", "area", "preference", "context", "examples"]
    },
    "event": {
      "description": "Significant event (task complete, milestone, issue)",
      "fields": ["timestamp", "what", "outcome", "next_steps"]
    },
    "failure": {
      "description": "Mistake or failed attempt — what went wrong and the fix",
      "fields": ["timestamp", "attempt", "error", "fix", "lesson"]
    },
    "chat": {
      "description": "Casual chat that revealed useful info or context",
      "fields": ["timestamp", "topic", "detail", "importance"]
    },
    "chat_insight": {
      "description": "Casual chat that unexpectedly revealed useful info",
      "fields": ["timestamp", "topic", "insight", "importance"]
    },
    "context_switch": {
      "description": "Change in active project, task, or focus area",
      "fields": ["timestamp", "from", "to", "reason"]
    },
    "insight": {
      "description": "Observation or pattern noticed across interactions",
      "fields": ["timestamp", "observation", "evidence", "implication"]
    }
  },
  "tiers": {
    "description": "三层存储架构",
    "raw": {
      "path": "auto/raw/YYYY-MM-DD.raw.json",
      "description": "🥉 全量最小格式日志，只增不改，永不删除。每条 ~50-100 bytes",
      "fields": ["t", "s", "tp", "fp"],
      "field_map": {
        "t": "timestamp (HH:MM:SS)",
        "s": "summary (title)",
        "tp": "entry type",
        "fp": "fingerprint"
      },
      "retention": "永久"
    },
    "daily": {
      "path": "auto/YYYY-MM-DD.json",
      "description": "🥈 当天去重后的完整条目，含 detail / tags / hit_count",
      "retention": "保留至下轮 compress 后，原始信息在 raw 中永存"
    },
    "consolidated": {
      "path": "curated/consolidated.json",
      "description": "🥇 跨天压缩，高频全量保留 + 低频 title_only",
      "tier_rules": {
        "hot":   {"min_score": 8,  "max": 20,  "retention": "全量 detail"},
        "warm":  {"min_score": 3,  "max": 100, "retention": "全量 detail"},
        "cold":  {"min_score": 0,             "retention": "title_only + SQLite rowid 指针，detail 通过 FTS5 memories 表 O(1) 检索"}
      }
    }
  },
  "entry_schema": {
    "description": "完整条目的字段定义",
    "required": ["id", "timestamp", "type", "summary", "fingerprint"],
    "properties": {
      "id": {"type": "string"},
      "timestamp": {"type": "string"},
      "type": {"type": "string", "enum": ["knowledge", "decision", "preference", "event", "failure", "chat", "chat_insight", "context_switch", "insight"]},
      "summary": {"type": "string", "maxLength": 200},
      "detail": {"type": "string"},
      "tags": {"type": "array", "items": {"type": "string"}},
      "fingerprint": {"type": "string"},
      "hit_count": {"type": "integer", "minimum": 1},
      "last_hit": {"type": "string"},
      "score": {"type": "number"},
      "tier": {"type": "string", "enum": ["hot", "warm", "cold", "archive"]},
      "importance": {"type": "integer", "minimum": 1, "maximum": 10, "description": "重要性评分 1-10, 影响热度计算权重"},
      "context": {"type": "string"},
      "related_ids": {"type": "array", "items": {"type": "string"}},
      "author": {"type": "string"},
      "contributors": {"type": "array", "items": {"type": "string"}},
      "merged_from": {"type": "array", "items": {"type": "string"}},

      "title_only": {
        "type": "boolean",
        "description": "true 表示此条目在 consolidated 中仅保留 title，detail 需从 raw 日志中按 fingerprint 回溯"
      },
      "source_raw": {
        "type": "string",
        "description": "当 title_only=true，指向原始 raw 日志文件路径"
      }
    }
  },
  "scoring": {
    "formula": "Score = I × e^(-λt) × log(f+1)",
    "half_life_days": 21,
    "lambda_per_day": 0.033,
    "importance_scale": "1-10, 默认5",
    "activity_labels": {
      "<14d": "high",
      "14-28d": "medium",
      "28-42d": "low",
      ">42d": "weak"
    },
    "title_only_threshold": {
      "cold_entries": true,
      "types_always_full": ["knowledge", "decision", "insight", "failure"],
      "types_prefer_title": ["event", "context_switch", "chat", "chat_insight"],
      "override_if_hit_count_ge": 3
    }
  },
  "compress": {
    "version": "v3",
    "algorithm": "1) dirty check → 2) fingerpt group & merge → 3) exchange demotion → 4) cold detail→SQLite → 5) write consolidated",
    "exchange_demotion": {
      "hot_cap": 20,
      "warm_cap": 100,
      "warm_saturation_pct": 90,
      "description": "Hot-bottom→Warm-front, Warm-bottom→Cold, 数量对等. Warm <90% 时抑制 Cold 降级"
    },
    "idle_check": {
      "threshold_sec": 300,
      "method": "idle_monitor.ps1 (Win) + 6-sample consecutive counter",
      "description": "检测 Windows 用户鼠标+键盘空闲 >5 分钟才触发"
    },
    "dirty_check": "compare mtime of compressed vs latest_raw/auto",
    "trigger": "闲时 (5min idle) + 有新内容 或 每天 0 点定时",
    "typical_time_ms": 200
  }
}
